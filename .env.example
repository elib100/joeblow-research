# reddit_research configuration — schema only, no values that need to be secret.
# The .json transport requires no auth, so this file has no secrets in MVP.
# Real values live in `.env` (gitignored). Optional in MVP — defaults work.
#
# Production: /home/redditmcp/reddit-cache/.env (owned by redditmcp:redditmcp, mode 0600)
# Dev: /home/elib/code/reddit_api/.env (owned by elib:elib, mode 0600)

# Reddit blocks generic User-Agents at the edge. Use a real, identifying string.
# Format: <platform>:<app-id>:<version> (by /u/<username>)
REDDIT_USER_AGENT=reddit-research:0.1 (by /u/joeblowfromidaho)

# Optional. Defaults to ~/.cache/reddit-research/ if unset.
# Production should set to /home/redditmcp/reddit-cache/.
REDDIT_CACHE_DIR=

# ---------------------------------------------------------------------------
# Future OAuth upgrade path — NOT used in MVP, NOT required to be filled in.
# Only relevant if/when Reddit grants API access via the support form, at
# which point we'd add OAuth alongside the .json transport for higher rate
# limits / write capability. Until then, leave these blank.
# ---------------------------------------------------------------------------

# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=joeblowfromidaho
# REDDIT_PASSWORD=
# REDDIT_WRITE_ENABLED=false
