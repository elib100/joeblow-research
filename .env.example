# reddit_research credentials — schema only, no values.
# Real values live in `.env` (gitignored, mode 0600). Never commit `.env`.
#
# Production: /home/redditmcp/reddit-cache/.env (owned by redditmcp:redditmcp, mode 0600)
# Dev/Phase 0: /home/elib/code/reddit_api/.env (owned by elib:elib, mode 0600)

# OAuth script app credentials from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Reddit account credentials (script app + password grant for MVP)
REDDIT_USERNAME=joeblowfromidaho
REDDIT_PASSWORD=

# Required by Reddit. Format: <platform>:<app-id>:<version> (by /u/<username>)
REDDIT_USER_AGENT=reddit-research:0.1 (by /u/joeblowfromidaho)

# Write-safety gate. Default OFF. Set to "true" to enable write operations
# (post / comment / vote). Defense in depth: PRAW also gets read_only=True
# whenever this is unset/false.
REDDIT_WRITE_ENABLED=false

# Cache + audit log location. Production should set to /home/redditmcp/reddit-cache/.
# Dev defaults to ~/.cache/reddit-research/ if unset.
REDDIT_CACHE_DIR=
